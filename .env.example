INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# ---- Session JWT ----
SESSION_SECRET=

# ---- QR code signing HMAC ----
QR_SIGNING_SECRET=

# ---- Resend email API ----
RESEND_API_KEY=

# ---- Cloudinary (server-side uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email addresses / sender names ----
COMPANY_EMAIL=
COMPANY_EMAIL_NAME=
FROM_EMAIL=
